{
  "name": "voxora-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "React frontend for the Voxora desktop shell",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "24.15.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "format:check": "prettier --check \"src/**/*.{css,ts,tsx}\" \"*.{html,json,mjs,ts}\" \"src-tauri/tauri.conf.json\" \"src-tauri/capabilities/*.json\" \"../../scripts/*.mjs\" \"../../schemas/*.json\" \"../../.github/workflows/*.yml\"",
    "licenses:check": "node ../../scripts/check-npm-licenses.mjs && node --test ../../scripts/check-npm-licenses.test.mjs",
    "models:check": "node ../../scripts/validate-model-manifests.mjs && node --test ../../scripts/validate-model-manifests.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
